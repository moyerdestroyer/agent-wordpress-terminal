{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://awpt.dev/schemas/awpt-domain-v2.json",
	"title": "AWPT Domain Pack v2",
	"type": "object",
	"additionalProperties": false,
	"required": ["schema_version", "id", "label", "version"],
	"properties": {
		"$schema": { "type": "string" },
		"schema_version": { "const": 2 },
		"id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
		"label": { "type": "string", "minLength": 1 },
		"version": { "type": "string", "minLength": 1 },
		"guidance": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["id", "path"],
				"properties": {
					"id": { "type": "string" },
					"label": { "type": "string" },
					"path": { "type": "string" },
					"applies_to": {
						"type": "array",
						"items": {
							"enum": [
								"all",
								"compose",
								"edit",
								"template",
								"navigation",
								"global_styles",
								"diagnose",
								"investigate"
							]
						}
					},
					"triggers": { "type": "array", "items": { "type": "string" } },
					"audience": { "enum": ["editor", "developer", "all"] },
					"priority": { "type": "integer", "minimum": 0, "maximum": 100 },
					"hard": { "type": "boolean" }
				}
			}
		},
		"patterns": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"namespace": { "type": "string" },
				"catalog": { "type": "string" },
				"aliases": {
					"type": "object",
					"description": "Thrash recovery map: requested pattern name → canonical registered slug (e.g. theme/page-header → theme/header-page).",
					"additionalProperties": { "type": "string", "minLength": 1 }
				}
			}
		},
		"rules": {
			"type": "object",
			"additionalProperties": false,
			"required": ["path"],
			"properties": {
				"path": { "type": "string" }
			}
		},
		"design": {
			"type": "object",
			"additionalProperties": false,
			"required": ["catalog"],
			"properties": {
				"catalog": { "type": "string", "minLength": 1 }
			}
		},
		"validators": { "type": "array", "items": { "type": "string" } },
		"recommenders": { "type": "array", "items": { "type": "string" } },
		"materializers": { "type": "array", "items": { "type": "string" } },
		"proposal_operations": { "type": "array", "items": { "type": "string" } }
	}
}
